{
  "name": "@dada78641/bot-tombawiki",
  "description": "Bot that posts Tomba Club Wiki updates to Discord",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "scripts": {
    "bot": "tsx src/init.ts",
    "check": "tsc -p ./tsconfig.json --noEmit",
    "migrate": "tsx src/init.ts -- --migrate",
    "dump": "tsx src/init.ts -- --dump",
    "studio": "tsx node_modules/.bin/drizzle-kit studio --config=src/config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msikma/cronbot.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.8.6",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@dada78641/cronbot": "^0.2.0",
    "@dada78641/mwrecent": "^0.0.6",
    "discord.js": "^14.16.3"
  }
}
